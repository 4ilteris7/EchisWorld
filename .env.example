# Optional public-source provider credentials.
# Copy this file to .env.local and fill only the providers you use.
# Never commit .env.local or real credentials.

CURRENTS_API_KEY=
FINLIGHT_API_KEY=
FREENEWSAPI_KEY=
GUARDIAN_API_KEY=
NEWSDATA_API_KEY=
WORLDNEWS_API_KEY=


# Optional IP-to-timezone/geocoding provider.
FINDIP_API_KEY=

# Recommended when calling public ADS-B services. Use an application name and
# a monitored contact address; do not place secrets in this value.

# Optional logging level: debug, info, warn, or error.
ECHIS_LOG_LEVEL=info

# Local PostgreSQL credentials and ports are generated automatically in the
# ignored .env.echis-local file by `npm run local:setup`.
